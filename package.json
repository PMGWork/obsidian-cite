{
  "name": "obsidian-cite",
  "version": "0.1.0",
  "description": "Render and link LaTeX or Pandoc citations from BibTeX blocks in your notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint main.ts src tests",
    "test": "vitest run",
    "validate-version": "node scripts/check-version.mjs",
    "check": "npm run validate-version && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "9.32.0",
    "@types/node": "22.17.0",
    "builtin-modules": "4.0.0",
    "esbuild": "0.25.8",
    "eslint": "9.32.0",
    "obsidian": "1.12.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  }
}
